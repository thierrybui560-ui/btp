<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module 15: btp.audit.log access (defined in XML so model ref resolves after models are loaded) -->
        <record id="access_btp_audit_log_manager" model="ir.model.access">
            <field name="name">btp.audit.log.manager</field>
            <field name="model_id" ref="btp_prospecting.model_btp_audit_log"/>
            <field name="group_id" ref="group_btp_manager"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="access_btp_audit_log_admin" model="ir.model.access">
            <field name="name">btp.audit.log.admin</field>
            <field name="model_id" ref="btp_prospecting.model_btp_audit_log"/>
            <field name="group_id" ref="group_btp_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
