<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_btp_generic">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._get_report_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="article">
                            <h2 class="mb-3" t-esc="data.get('title', doc.name)"/>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <t t-foreach="data.get('headers', [])" t-as="header">
                                            <th t-esc="header"/>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="data.get('rows', [])" t-as="row">
                                        <tr>
                                            <t t-foreach="row" t-as="cell">
                                                <td t-esc="cell"/>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <p class="text-muted mt-3">
                                <t t-esc="doc.name"/> — <t t-esc="doc.scope"/> — <t t-esc="doc.output_format"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
