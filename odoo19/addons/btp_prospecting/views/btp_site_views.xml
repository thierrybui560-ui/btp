<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit project list so view type is 'list' (avoids "No default view of type tree" when client requests list) -->
    <record id="view_btp_site_tree" model="ir.ui.view">
        <field name="name">btp.site.list</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="btp_site_code" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="btp_start_date" optional="hide"/>
                <field name="btp_end_date_planned" optional="hide"/>
                <field name="btp_is_blocked" optional="hide"/>
                <field name="btp_missing_document_count" optional="hide"/>
                <field name="btp_expired_document_count" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_btp_site_form" model="ir.ui.view">
        <field name="name">btp.site.form</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="BTP Site">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_tasks" icon="fa-tasks">
                            <field string="Tasks" name="task_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_btp_view_invoices" icon="fa-file-text-o" invisible="btp_invoice_count == 0">
                            <field string="Invoices" name="btp_invoice_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="btp_site_code" readonly="1"/>
                            <field name="name"/>
                            <field name="partner_id" string="Client"/>
                            <field name="user_id" string="Site Manager"/>
                            <field name="btp_sale_order_id"/>
                        </group>
                        <group>
                            <field name="btp_start_date"/>
                            <field name="btp_end_date_planned"/>
                            <field name="btp_end_date_actual"/>
                            <field name="btp_is_blocked" readonly="1"/>
                            <field name="btp_retention_rate"/>
                            <field name="btp_retention_release_date"/>
                        </group>
                    </group>
                    <group string="Location">
                        <group>
                            <field name="btp_site_address"/>
                            <field name="btp_site_city"/>
                            <field name="btp_site_zip"/>
                            <field name="btp_site_country_id"/>
                        </group>
                        <group>
                            <field name="btp_site_latitude"/>
                            <field name="btp_site_longitude"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stakeholders">
                            <group>
                                <field name="btp_client_contact_ids" widget="many2many_tags"/>
                                <field name="btp_subcontractor_ids" widget="many2many_tags"/>
                                <field name="btp_supplier_ids" widget="many2many_tags"/>
                                <field name="btp_employee_ids" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Situations &amp; Invoicing" name="btp_situations">
                            <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                                <button name="action_btp_new_situation" type="object" string="Create situation"
                                        class="oe_highlight btn-primary"
                                        invisible="btp_sale_order_id == False"/>
                                <button name="action_btp_create_deposit_invoice" type="object" string="Create deposit invoice"
                                        invisible="btp_sale_order_id == False or not partner_id"/>
                                <button name="action_btp_create_final_invoice" type="object" string="Create final invoice"
                                        invisible="btp_sale_order_id == False or not partner_id or btp_has_final_invoice"/>
                                <field name="btp_has_final_invoice" invisible="1"/>
                            </div>
                            <field name="btp_situation_ids" nolabel="1" context="{'default_site_id': id}" mode="list">
                                <list create="0" delete="1" edit="1">
                                    <field name="situation_date" string="Date"/>
                                    <field name="state" string="Status"/>
                                    <field name="amount_total" string="Progress"/>
                                    <field name="amount_retention" string="Retention"/>
                                    <field name="amount_to_invoice" string="To invoice"/>
                                    <field name="invoice_id" string="Invoice"/>
                                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-link"
                                            invisible="state != 'confirmed' or invoice_id" icon="fa-file-text-o"/>
                                </list>
                            </field>
                            <group string="Margin (forecast vs actual)" name="btp_margin">
                                <group>
                                    <field name="btp_quote_total" readonly="1"/>
                                    <field name="btp_invoiced_total" readonly="1"/>
                                </group>
                                <group>
                                    <field name="btp_actual_costs" readonly="1"/>
                                    <field name="btp_net_margin" readonly="1"/>
                                    <field name="btp_margin_percent" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Planning" name="btp_planning">
                            <group>
                                <button name="action_btp_generate_planning" type="object" string="Generate planning from quote"
                                        class="oe_highlight"
                                        invisible="btp_sale_order_id == False or btp_planning_task_count &gt; 0"/>
                                <field name="btp_planning_task_count" invisible="1"/>
                            </group>
                            <field name="task_ids" nolabel="1" context="{'default_project_id': id}" mode="list" create="1" delete="1" edit="1"/>
                        </page>
                        <page string="Documents">
                            <field name="btp_document_ids" nolabel="1" context="{'default_site_id': id}">
                                <list>
                                    <field name="category"/>
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="version_label"/>
                                    <field name="issue_date"/>
                                    <field name="expiration_date"/>
                                    <field name="is_expired" widget="boolean_toggle"/>
                                    <field name="expires_soon" widget="boolean_toggle"/>
                                    <field name="supplier_id"/>
                                    <field name="subcontractor_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Checklist">
                            <field name="btp_document_requirement_ids" nolabel="1" context="{'default_site_id': id}">
                                <list editable="bottom">
                                    <field name="category"/>
                                    <field name="document_type"/>
                                    <field name="is_mandatory"/>
                                    <field name="required_before_start"/>
                                    <field name="missing" widget="boolean_toggle"/>
                                    <field name="expired" widget="boolean_toggle"/>
                                    <field name="fulfilled" widget="boolean_toggle"/>
                                    <field name="last_document_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contracts">
                            <field name="btp_document_ids" nolabel="1"
                                   domain="[('category', '=', 'contract')]"
                                   context="{'default_site_id': id, 'default_category': 'contract'}">
                                <list>
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="version_label"/>
                                    <field name="issue_date"/>
                                    <field name="expiration_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical Documents">
                            <field name="btp_document_ids" nolabel="1"
                                   domain="[('category', '=', 'technical')]"
                                   context="{'default_site_id': id, 'default_category': 'technical'}">
                                <list>
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="version_label"/>
                                    <field name="issue_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Safety">
                            <field name="btp_document_ids" nolabel="1"
                                   domain="[('category', '=', 'regulatory')]"
                                   context="{'default_site_id': id, 'default_category': 'regulatory'}">
                                <list>
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="version_label"/>
                                    <field name="issue_date"/>
                                    <field name="expiration_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Supplier/Subcontractor">
                            <field name="btp_document_ids" nolabel="1"
                                   domain="[('category', '=', 'supplier')]"
                                   context="{'default_site_id': id, 'default_category': 'supplier'}">
                                <list>
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="supplier_id"/>
                                    <field name="subcontractor_id"/>
                                    <field name="issue_date"/>
                                    <field name="expiration_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Miscellaneous">
                            <field name="btp_document_ids" nolabel="1"
                                   domain="[('category', '=', 'misc')]"
                                   context="{'default_site_id': id, 'default_category': 'misc'}">
                                <list>
                                    <field name="document_type"/>
                                    <field name="name"/>
                                    <field name="issue_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_btp_site_search" model="ir.ui.view">
        <field name="name">btp.site.search</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search string="Search Sites">
                <field name="btp_site_code"/>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Blocked" name="blocked" domain="[('btp_is_blocked', '=', True)]"/>
                <filter string="Missing Documents" name="missing_docs" domain="[('btp_missing_document_count', '>', 0)]"/>
                <filter string="Expired Documents" name="expired_docs" domain="[('btp_expired_document_count', '>', 0)]"/>
                <filter string="Delayed" name="delayed"
                        domain="[('btp_end_date_planned', '!=', False), ('btp_end_date_planned', '&lt;', context_today()), ('btp_end_date_actual', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Client" name="group_client" context="{'group_by': 'partner_id'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_btp_sites" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_btp_site_search"/>
        <field name="context">{'default_allow_billable': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first site
            </p>
            <p>
                Sites are created automatically from accepted quotes, or can be created manually.
            </p>
        </field>
    </record>
</odoo>
