<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit customer invoice form to show BTP fields when btp_site_id is set -->
    <record id="view_account_move_btp_form" model="ir.ui.view">
        <field name="name">account.move.btp.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- BTP: Create revision button (posted BTP invoice only); opens new draft with same BTP number and next revision letter -->
            <xpath expr="//button[@name='action_reverse']" position="after">
                <button name="action_btp_create_revision" type="object" string="Create revision"
                        invisible="state != 'posted' or move_type != 'out_invoice' or not btp_invoice_sequence"
                        groups="account.group_account_invoice"
                        title="Create a new draft invoice with the same BTP number and the next revision letter (A, B, C…)"/>
            </xpath>
            <!-- Add full-width BTP section as a new row (after the header row) so values are fully visible -->
            <xpath expr="//group[.//div[@name='due_date']]" position="after">
                <group string="BTP Invoicing" invisible="btp_site_id == False">
                    <group>
                        <field name="btp_invoice_type"/>
                        <field name="btp_invoice_sequence" readonly="1"/>
                        <field name="btp_revision_index" readonly="state != 'draft'"/>
                        <field name="btp_site_id"/>
                        <field name="btp_situation_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="btp_retention_rate"/>
                        <field name="btp_retention_amount"/>
                        <field name="btp_deposit_deduction" readonly="1"/>
                        <field name="payment_state" string="Payment Status" readonly="1"/>
                        <field name="btp_reminder_status" string="BTP Reminder Status"/>
                        <field name="btp_reminder_courtesy_sent" readonly="1"/>
                        <field name="btp_reminder_official_sent" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <!-- Inherit customer invoice list to show BTP columns -->
    <record id="view_account_move_btp_list" model="ir.ui.view">
        <field name="name">account.move.btp.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="payment_state" string="Payment Status" optional="show"/>
                <field name="btp_invoice_type" optional="hide"/>
                <field name="btp_invoice_sequence" optional="hide"/>
                <field name="btp_site_id" optional="hide"/>
                <field name="btp_reminder_status" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
