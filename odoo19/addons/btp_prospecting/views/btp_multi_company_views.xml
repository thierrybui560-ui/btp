<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module 13 — Multi-companies: extend company form with BTP sharing policy -->
    <record id="view_res_company_form_btp_multi_company" model="ir.ui.view">
        <field name="name">res.company.form.btp.multi.company</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="inside">
                <group string="BTP Multi-company" name="btp_multi_company" colspan="2">
                    <group>
                        <field name="btp_siren" placeholder="e.g. 123456789"/>
                        <field name="btp_shared_clients"/>
                    </group>
                    <group>
                        <field name="btp_shared_suppliers"/>
                        <field name="btp_shared_articles"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Action: open companies (for multi-company settings) -->
    <record id="action_btp_res_company_multi" model="ir.actions.act_window">
        <field name="name">Companies (Multi-company)</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure companies</p>
            <p>Set BTP multi-company options per company: SIREN, and whether this company uses shared clients, suppliers, or articles.</p>
        </field>
    </record>

    <!-- Action: consolidation reports (Module 13 scopes only) -->
    <record id="action_btp_consolidation_reports" model="ir.actions.act_window">
        <field name="name">Consolidation Reports</field>
        <field name="res_model">btp.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('scope', 'in', ['consolidated_turnover', 'consolidated_cash', 'consolidated_margin', 'shared_clients_distribution'])]</field>
        <field name="search_view_id" ref="view_btp_report_template_search"/>
        <field name="context">{'default_scope': 'consolidated_turnover'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a consolidation report</p>
            <p>Turnover by company, cash/invoiced by company, net margin by company and site, or shared clients distribution. Use "Company" on the template to filter to one entity, or leave empty for full group consolidation.</p>
        </field>
    </record>
</odoo>
