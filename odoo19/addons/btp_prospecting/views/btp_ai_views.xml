<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lead AI fields -->
    <record id="view_btp_lead_form_ai_inherit" model="ir.ui.view">
        <field name="name">btp.lead.form.ai.inherit</field>
        <field name="model">btp.lead</field>
        <field name="inherit_id" ref="btp_prospecting.view_btp_lead_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="AI">
                    <group>
                        <group>
                            <field name="ai_score"/>
                            <field name="ai_last_scored_at"/>
                        </group>
                        <group>
                            <button name="action_ai_rescore" type="object" string="Recompute AI Score" class="btn-primary"/>
                        </group>
                    </group>
                    <group>
                        <field name="ai_score_reason" readonly="1"/>
                        <field name="ai_briefing" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- AI Providers -->
    <record id="view_btp_ai_provider_tree" model="ir.ui.view">
        <field name="name">btp.ai.provider.tree</field>
        <field name="model">btp.ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="provider_type"/>
                <field name="model_name"/>
                <field name="endpoint"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_btp_ai_provider_form" model="ir.ui.view">
        <field name="name">btp.ai.provider.form</field>
        <field name="model">btp.ai.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="provider_type"/>
                        <field name="model_name"/>
                    </group>
                    <group>
                        <field name="endpoint"/>
                        <field name="api_key_config_param"/>
                        <field name="temperature"/>
                        <field name="timeout_seconds"/>
                        <field name="retry_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_btp_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">btp.ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Prompt templates -->
    <record id="view_btp_prompt_template_tree" model="ir.ui.view">
        <field name="name">btp.prompt.template.tree</field>
        <field name="model">btp.prompt.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="company_id"/>
                <field name="provider_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_btp_prompt_template_form" model="ir.ui.view">
        <field name="name">btp.prompt.template.form</field>
        <field name="model">btp.prompt.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="version"/>
                        <field name="company_id"/>
                        <field name="active"/>
                        <field name="provider_id"/>
                    </group>
                    <group>
                        <field name="system_prompt"/>
                        <field name="user_prompt_template"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_btp_prompt_template" model="ir.actions.act_window">
        <field name="name">AI Prompt Templates</field>
        <field name="res_model">btp.prompt.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- AI logs -->
    <record id="view_btp_ai_log_tree" model="ir.ui.view">
        <field name="name">btp.ai.log.tree</field>
        <field name="model">btp.ai.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="provider_id"/>
                <field name="model_name"/>
                <field name="status"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="action_btp_ai_log" model="ir.actions.act_window">
        <field name="name">AI Logs</field>
        <field name="res_model">btp.ai.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tender watch -->
    <record id="view_btp_tender_source_tree" model="ir.ui.view">
        <field name="name">btp.tender.source.tree</field>
        <field name="model">btp.tender.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="source_type"/>
                <field name="url"/>
                <field name="default_company_id"/>
                <field name="default_open_mode"/>
                <field name="last_fetch_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_btp_tender_source_form" model="ir.ui.view">
        <field name="name">btp.tender.source.form</field>
        <field name="model">btp.tender.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="source_type"/>
                        <field name="url"/>
                        <field name="default_company_id"/>
                        <field name="default_open_mode"/>
                        <field name="last_fetch_at" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_btp_tender_watch_run_tree" model="ir.ui.view">
        <field name="name">btp.tender.watch.run.tree</field>
        <field name="model">btp.tender.watch.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="company_id"/>
                <field name="source_id"/>
                <field name="status"/>
                <field name="lead_created_count"/>
                <field name="error_message"/>
            </list>
        </field>
    </record>

    <record id="action_btp_tender_source" model="ir.actions.act_window">
        <field name="name">Tender Sources</field>
        <field name="res_model">btp.tender.source</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_btp_tender_watch_runs" model="ir.actions.act_window">
        <field name="name">Tender Watch Runs</field>
        <field name="res_model">btp.tender.watch.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- RAG starter -->
    <record id="view_btp_rag_document_tree" model="ir.ui.view">
        <field name="name">btp.rag.document.tree</field>
        <field name="model">btp.rag.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="source_model"/>
                <field name="source_res_id"/>
                <field name="chunk_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_btp_rag_document_form" model="ir.ui.view">
        <field name="name">btp.rag.document.form</field>
        <field name="model">btp.rag.document</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="source_model"/>
                        <field name="source_res_id"/>
                        <field name="chunk_count" readonly="1"/>
                    </group>
                    <group>
                        <field name="text_content"/>
                    </group>
                    <notebook>
                        <page string="Chunks">
                            <field name="chunk_ids" readonly="1">
                                <list>
                                    <field name="sequence"/>
                                    <field name="token_estimate"/>
                                    <field name="embedding_key"/>
                                    <field name="content"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="reindex_chunks" string="Reindex Chunks" type="object" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_btp_rag_document" model="ir.actions.act_window">
        <field name="name">RAG Documents</field>
        <field name="res_model">btp.rag.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_btp_lead_score_logs" model="ir.actions.act_window">
        <field name="name">Lead Score Logs</field>
        <field name="res_model">btp.lead.score.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_btp_lead_score_log_tree" model="ir.ui.view">
        <field name="name">btp.lead.score.log.tree</field>
        <field name="model">btp.lead.score.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="scored_at"/>
                <field name="company_id"/>
                <field name="lead_id"/>
                <field name="score"/>
                <field name="model_info"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <!-- AI menus -->
    <menuitem id="menu_btp_ai_root"
              name="AI Automation"
              parent="menu_btp_configuration"
              sequence="80"
              groups="btp_prospecting.group_btp_manager"/>
    <menuitem id="menu_btp_ai_provider"
              name="Providers"
              parent="menu_btp_ai_root"
              action="action_btp_ai_provider"
              sequence="10"
              groups="btp_prospecting.group_btp_manager"/>
    <menuitem id="menu_btp_ai_prompt"
              name="Prompt Templates"
              parent="menu_btp_ai_root"
              action="action_btp_prompt_template"
              sequence="20"
              groups="btp_prospecting.group_btp_manager"/>
    <menuitem id="menu_btp_ai_logs"
              name="AI Logs"
              parent="menu_btp_ai_root"
              action="action_btp_ai_log"
              sequence="30"
              groups="btp_prospecting.group_btp_manager"/>
    <menuitem id="menu_btp_ai_tender_source"
              name="Tender Sources"
              parent="menu_btp_ai_root"
              action="action_btp_tender_source"
              sequence="40"
              groups="btp_prospecting.group_btp_manager"/>
    <menuitem id="menu_btp_ai_tender_runs"
              name="Tender Runs"
              parent="menu_btp_ai_root"
              action="action_btp_tender_watch_runs"
              sequence="50"
              groups="btp_prospecting.group_btp_manager"/>
    <menuitem id="menu_btp_ai_rag"
              name="RAG Documents"
              parent="menu_btp_ai_root"
              action="action_btp_rag_document"
              sequence="60"
              groups="btp_prospecting.group_btp_manager"/>
    <menuitem id="menu_btp_ai_score_logs"
              name="Lead Score Logs"
              parent="menu_btp_ai_root"
              action="action_btp_lead_score_logs"
              sequence="70"
              groups="btp_prospecting.group_btp_manager"/>
</odoo>
