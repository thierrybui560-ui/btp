<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Template list -->
    <record id="view_btp_report_template_list" model="ir.ui.view">
        <field name="name">btp.report.template.list</field>
        <field name="model">btp.report.template</field>
        <field name="arch" type="xml">
            <list string="Report Templates" default_order="name">
                <field name="name"/>
                <field name="scope"/>
                <field name="output_format"/>
                <field name="schedule"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id"/>
                <field name="export_job_count" string="Exports"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Report Template form -->
    <record id="view_btp_report_template_form" model="ir.ui.view">
        <field name="name">btp.report.template.form</field>
        <field name="model">btp.report.template</field>
        <field name="arch" type="xml">
            <form string="Report Template">
                <header>
                    <button name="action_run_report" string="Generate and Send by Email" type="object" class="btn-primary"/>
                    <button name="action_run_report_no_email" string="Generate (no email)" type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_open_export_jobs" icon="fa-file-o" invisible="export_job_count == 0">
                            <field string="Exports" name="export_job_count" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="scope"/>
                            <field name="output_format"/>
                            <field name="schedule"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Email Recipients" colspan="2">
                        <field name="recipient_user_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Export History" name="exports">
                            <field name="export_job_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="run_date"/>
                                    <field name="state"/>
                                    <field name="attachment_id"/>
                                    <field name="error_message"/>
                                    <button name="action_download" type="object" string="Download" icon="fa-download" invisible="state != 'done'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_btp_report_template_search" model="ir.ui.view">
        <field name="name">btp.report.template.search</field>
        <field name="model">btp.report.template</field>
        <field name="arch" type="xml">
            <search string="Search Report Templates">
                <field name="name"/>
                <field name="scope"/>
                <filter string="Scheduled" name="scheduled" domain="[('schedule', '!=', 'none')]"/>
                <filter string="PDF" name="pdf" domain="[('output_format', '=', 'pdf')]"/>
                <filter string="Excel" name="xlsx" domain="[('output_format', '=', 'xlsx')]"/>
                <filter string="CSV" name="csv" domain="[('output_format', '=', 'csv')]"/>
            </search>
        </field>
    </record>

    <record id="action_btp_report_templates" model="ir.actions.act_window">
        <field name="name">Report Templates</field>
        <field name="res_model">btp.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_btp_report_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a report template</p>
            <p>Define scope (e.g. Leads &amp; Quotes by Salesperson, Site Progress), output format (PDF, Excel, CSV), optional schedule and recipients. Then run the report from the form (Generate) or let the scheduler send it by email.</p>
        </field>
    </record>

    <!-- Export Job list -->
    <record id="view_btp_export_job_list" model="ir.ui.view">
        <field name="name">btp.export.job.list</field>
        <field name="model">btp.export.job</field>
        <field name="arch" type="xml">
            <list string="Export History" default_order="run_date desc">
                <field name="report_template_id"/>
                <field name="run_date"/>
                <field name="state"/>
                <field name="attachment_id"/>
                <field name="error_message"/>
                <button name="action_download" type="object" string="Download" icon="fa-download" invisible="state != 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_btp_export_job_form" model="ir.ui.view">
        <field name="name">btp.export.job.form</field>
        <field name="model">btp.export.job</field>
        <field name="arch" type="xml">
            <form string="Export Job">
                <sheet>
                    <group>
                        <group>
                            <field name="report_template_id"/>
                            <field name="run_date"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="attachment_id"/>
                        </group>
                    </group>
                    <group string="Error" invisible="state != 'failed'">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_download" string="Download" type="object" class="btn-primary" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_btp_export_jobs" model="ir.actions.act_window">
        <field name="name">Export History</field>
        <field name="res_model">btp.export.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
