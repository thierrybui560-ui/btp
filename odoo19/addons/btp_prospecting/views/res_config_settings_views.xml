<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.btp.prospecting</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="15"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="BTP Prospecting" name="btp_prospecting" groups="btp_prospecting.group_btp_manager">
                    <block title="Subcontractors" name="btp_subcontractor_settings">
                        <setting id="btp_subcontractor_blocking_setting"
                                 string="Block when subcontractor documents are invalid"
                                 help="When enabled, operations involving subcontractors with expired or missing documents may be blocked.">
                            <field name="btp_subcontractor_blocking_enabled"/>
                        </setting>
                        <setting id="btp_document_expiration_days_setting"
                                 string="Document expiration warning (days)"
                                 help="Number of days before expiration to flag subcontractor documents as expiring soon.">
                            <field name="btp_document_expiration_days"/>
                        </setting>
                        <setting id="btp_yield_alert_threshold_setting"
                                 string="Yield alert threshold (%)"
                                 help="Yield entries below this threshold are flagged.">
                            <field name="btp_yield_alert_threshold"/>
                        </setting>
                        <setting id="btp_yield_escalation_days_setting"
                                 string="Yield escalation delay (days)"
                                 help="Low-yield alerts older than this delay are escalated to management.">
                            <field name="btp_yield_escalation_days"/>
                        </setting>
                        <setting id="btp_default_internal_hourly_cost_setting"
                                 string="Default internal hourly cost"
                                 help="Fallback internal labor cost for site margin calculations.">
                            <field name="btp_default_internal_hourly_cost"/>
                        </setting>
                        <setting id="btp_default_subcontractor_hourly_cost_setting"
                                 string="Default subcontractor hourly cost"
                                 help="Fallback subcontractor labor cost for site margin calculations.">
                            <field name="btp_default_subcontractor_hourly_cost"/>
                        </setting>
                    </block>
                    <block title="System Governance (Module 15)" name="btp_governance_settings">
                        <setting id="btp_automatic_reattribution_setting"
                                 string="Enable automatic client reattribution"
                                 help="When enabled, clients with no activity for the configured number of days are reattributed to the salesperson's manager.">
                            <field name="btp_automatic_reattribution_enabled"/>
                        </setting>
                        <setting id="btp_reattribution_inactive_days_setting"
                                 string="Inactive client reattribution (days)"
                                 help="After this many days without activity, clients are reattributed to the manager (if automatic reattribution is enabled).">
                            <field name="btp_reattribution_inactive_days" invisible="not btp_automatic_reattribution_enabled"/>
                        </setting>
                    </block>
                    <block title="AI Governance (Annex)" name="btp_ai_governance_settings">
                        <setting id="btp_ai_enabled_setting"
                                 string="Enable AI external calls"
                                 help="Global kill-switch for external LLM provider calls.">
                            <field name="btp_ai_enabled"/>
                        </setting>
                        <setting id="btp_ai_daily_request_limit_setting"
                                 string="AI max requests per day"
                                 help="Maximum number of AI requests per company per day (0 = unlimited).">
                            <field name="btp_ai_daily_request_limit" invisible="not btp_ai_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
