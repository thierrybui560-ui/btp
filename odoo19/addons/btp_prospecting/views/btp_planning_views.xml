<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend project.task list: show BTP columns (quote item, planned qty, dates) -->
    <record id="view_project_task_tree_btp" model="ir.ui.view">
        <field name="name">project.task.tree.btp</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="btp_quote_item_id" optional="hide"/>
                <field name="date_assign" optional="hide"/>
                <field name="date_deadline" optional="hide"/>
                <field name="btp_planned_qty" optional="hide"/>
                <field name="btp_uom_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Extend project.task form for BTP: quote item, yield, pointing, consumption -->
    <record id="view_project_task_form_btp" model="ir.ui.view">
        <field name="name">project.task.form.btp</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='task_properties']" position="before">
                <group string="BTP Planning">
                    <group>
                        <field name="btp_quote_item_id" options="{'no_create': True}"/>
                        <field name="btp_planned_qty"/>
                        <field name="btp_uom_id"/>
                    </group>
                    <group>
                        <field name="date_assign" string="Start Date"/>
                        <field name="date_deadline" string="Planned End Date"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Yield" name="btp_yield" invisible="btp_quote_item_id == False">
                    <field name="btp_yield_entry_ids" nolabel="1" context="{'default_task_id': id, 'default_uom_id': btp_uom_id}">
                        <list create="1" delete="1" edit="1">
                            <field name="date"/>
                            <field name="expected_qty"/>
                            <field name="real_qty"/>
                            <field name="uom_id"/>
                            <field name="performance_rate"/>
                            <field name="yield_alert" widget="boolean_toggle"/>
                            <field name="notes"/>
                        </list>
                    </field>
                </page>
                <page string="Pointing" name="btp_pointing">
                    <field name="btp_pointing_ids" nolabel="1" context="{'default_task_id': id, 'default_site_id': project_id}">
                        <list create="1" delete="1" edit="1">
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="subcontractor_id"/>
                            <field name="hours"/>
                            <field name="qty_done"/>
                            <field name="uom_id"/>
                        </list>
                    </field>
                </page>
                <page string="Consumptions" name="btp_consumption" invisible="btp_quote_item_id == False">
                    <field name="btp_consumption_ids" nolabel="1" context="{'default_task_id': id, 'default_site_id': project_id, 'default_quote_item_id': btp_quote_item_id}">
                        <list create="1" delete="1" edit="1">
                            <field name="product_id"/>
                            <field name="planned_qty"/>
                            <field name="real_qty"/>
                            <field name="uom_id"/>
                            <field name="variance"/>
                            <field name="overconsumption_alert" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Yield entries: list, form, pivot, graph -->
    <record id="view_btp_site_performance_list" model="ir.ui.view">
        <field name="name">btp.site.performance.list</field>
        <field name="model">btp.site.performance</field>
        <field name="arch" type="xml">
            <list string="Yield Entries" create="1" delete="1" edit="1">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="expected_qty"/>
                <field name="real_qty"/>
                <field name="uom_id"/>
                <field name="performance_rate"/>
                <field name="yield_alert" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_btp_site_performance_form" model="ir.ui.view">
        <field name="name">btp.site.performance.form</field>
        <field name="model">btp.site.performance</field>
        <field name="arch" type="xml">
            <form string="Yield Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="expected_qty"/>
                            <field name="real_qty"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="performance_rate"/>
                            <field name="yield_alert"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_btp_site_performance_pivot" model="ir.ui.view">
        <field name="name">btp.site.performance.pivot</field>
        <field name="model">btp.site.performance</field>
        <field name="arch" type="xml">
            <pivot string="Yield Analysis">
                <field name="project_id" type="row"/>
                <field name="task_id" type="row"/>
                <field name="date" type="col"/>
                <field name="expected_qty" type="measure"/>
                <field name="real_qty" type="measure"/>
                <field name="performance_rate" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_btp_site_performance_graph" model="ir.ui.view">
        <field name="name">btp.site.performance.graph</field>
        <field name="model">btp.site.performance</field>
        <field name="arch" type="xml">
            <graph string="Yield" type="bar">
                <field name="project_id"/>
                <field name="expected_qty" type="measure"/>
                <field name="real_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pointing: list and form -->
    <record id="view_btp_site_pointing_list" model="ir.ui.view">
        <field name="name">btp.site.pointing.list</field>
        <field name="model">btp.site.pointing</field>
        <field name="arch" type="xml">
            <list string="Pointing" create="1" delete="1" edit="1">
                <field name="site_id"/>
                <field name="task_id"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="subcontractor_id"/>
                <field name="hours"/>
                <field name="hourly_rate" optional="hide"/>
                <field name="labor_cost"/>
                <field name="qty_done"/>
                <field name="uom_id"/>
            </list>
        </field>
    </record>
    <record id="view_btp_site_pointing_form" model="ir.ui.view">
        <field name="name">btp.site.pointing.form</field>
        <field name="model">btp.site.pointing</field>
        <field name="arch" type="xml">
            <form string="Pointing Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="task_id"/>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="subcontractor_id"/>
                        </group>
                        <group>
                            <field name="hours"/>
                            <field name="hourly_rate"/>
                            <field name="labor_cost" readonly="1"/>
                            <field name="qty_done"/>
                            <field name="uom_id"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_btp_site_pointing_pivot" model="ir.ui.view">
        <field name="name">btp.site.pointing.pivot</field>
        <field name="model">btp.site.pointing</field>
        <field name="arch" type="xml">
            <pivot string="Pointing Analysis">
                <field name="site_id" type="row"/>
                <field name="date" type="col"/>
                <field name="hours" type="measure"/>
                <field name="labor_cost" type="measure"/>
                <field name="qty_done" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Consumption: list and form -->
    <record id="view_btp_site_consumption_list" model="ir.ui.view">
        <field name="name">btp.site.consumption.list</field>
        <field name="model">btp.site.consumption</field>
        <field name="arch" type="xml">
            <list string="Consumptions" create="1" delete="1" edit="1">
                <field name="site_id"/>
                <field name="task_id"/>
                <field name="product_id"/>
                <field name="planned_qty"/>
                <field name="real_qty"/>
                <field name="uom_id"/>
                <field name="variance"/>
                <field name="overconsumption_alert" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_btp_site_consumption_form" model="ir.ui.view">
        <field name="name">btp.site.consumption.form</field>
        <field name="model">btp.site.consumption</field>
        <field name="arch" type="xml">
            <form string="Consumption">
                <sheet>
                    <group>
                        <group>
                            <field name="site_id"/>
                            <field name="task_id"/>
                            <field name="quote_item_id"/>
                            <field name="product_id"/>
                            <field name="planned_qty"/>
                            <field name="real_qty"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="variance"/>
                            <field name="overconsumption_alert"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_btp_site_consumption_pivot" model="ir.ui.view">
        <field name="name">btp.site.consumption.pivot</field>
        <field name="model">btp.site.consumption</field>
        <field name="arch" type="xml">
            <pivot string="Consumption Analysis">
                <field name="site_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="planned_qty" type="measure"/>
                <field name="real_qty" type="measure"/>
                <field name="variance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search views (must be defined before actions that ref them) -->
    <record id="search_btp_site_performance" model="ir.ui.view">
        <field name="name">btp.site.performance.search</field>
        <field name="model">btp.site.performance</field>
        <field name="arch" type="xml">
            <search string="Yield">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="date"/>
                <group>
                    <filter string="Task" name="group_task" context="{'group_by': 'task_id'}"/>
                    <filter string="Site" name="group_site" context="{'group_by': 'project_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_btp_site_pointing" model="ir.ui.view">
        <field name="name">btp.site.pointing.search</field>
        <field name="model">btp.site.pointing</field>
        <field name="arch" type="xml">
            <search string="Pointing">
                <field name="site_id"/>
                <field name="task_id"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="subcontractor_id"/>
                <group>
                    <filter string="Site" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Task" name="group_task" context="{'group_by': 'task_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_btp_site_consumption" model="ir.ui.view">
        <field name="name">btp.site.consumption.search</field>
        <field name="model">btp.site.consumption</field>
        <field name="arch" type="xml">
            <search string="Consumption">
                <field name="site_id"/>
                <field name="task_id"/>
                <field name="product_id"/>
                <group>
                    <filter string="Site" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Article" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_btp_site_performance" model="ir.actions.act_window">
        <field name="name">Yield Entries</field>
        <field name="res_model">btp.site.performance</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="search_view_id" ref="search_btp_site_performance"/>
        <field name="context">{'search_default_group_task': 1}</field>
    </record>
    <record id="action_btp_site_pointing" model="ir.actions.act_window">
        <field name="name">Pointing</field>
        <field name="res_model">btp.site.pointing</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="search_btp_site_pointing"/>
        <field name="context">{'search_default_group_site': 1}</field>
    </record>
    <record id="action_btp_site_consumption" model="ir.actions.act_window">
        <field name="name">Consumptions</field>
        <field name="res_model">btp.site.consumption</field>
        <field name="view_mode">list,form,pivot</field>
        <field name="search_view_id" ref="search_btp_site_consumption"/>
        <field name="context">{'search_default_group_site': 1}</field>
    </record>
</odoo>
