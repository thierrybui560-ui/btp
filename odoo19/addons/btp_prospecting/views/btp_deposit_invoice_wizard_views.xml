<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_btp_deposit_invoice_wizard_form" model="ir.ui.view">
        <field name="name">btp.deposit.invoice.wizard.form</field>
        <field name="model">btp.deposit.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Deposit Invoice">
                <group>
                    <field name="site_id" readonly="1"/>
                    <field name="amount" widget="monetary"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create_deposit_invoice" string="Create Deposit Invoice" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
