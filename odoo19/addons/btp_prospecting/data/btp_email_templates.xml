<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Lead Reminder Email Template -->
        <record id="email_template_lead_reminder" model="mail.template">
            <field name="name">BTP Lead: Reminder</field>
            <field name="model_id" ref="model_btp_lead"/>
            <field name="subject">Lead Reminder: {{ object.name }}</field>
            <field name="email_from">{{ object.create_uid.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.user_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello <t t-esc="object.user_id.name"/>,</p>
                    <p>This is a reminder for the following lead:</p>
                    <ul>
                        <li><strong>Lead:</strong> <t t-esc="object.name"/></li>
                        <li><strong>Site:</strong> <t t-esc="object.site_name or 'N/A'"/></li>
                        <li><strong>Client:</strong> <t t-esc="object.partner_id.name or object.partner_name or 'N/A'"/></li>
                        <li><strong>Stage:</strong> <t t-esc="object.stage_id.name or 'N/A'"/></li>
                        <li><strong>Next Reminder:</strong> <t t-esc="object.next_reminder_date or 'N/A'"/></li>
                    </ul>
                    <p>Please follow up on this lead as soon as possible.</p>
                    <p>Best regards,<br/>BTP Prospecting System</p>
                </div>
            </field>
        </record>

        <!-- Lead Escalation Email Template -->
        <record id="email_template_lead_escalation" model="mail.template">
            <field name="name">BTP Lead: Escalation</field>
            <field name="model_id" ref="model_btp_lead"/>
            <field name="subject">Lead Escalation: {{ object.name }} (Stalled for 30+ days)</field>
            <field name="email_from">{{ object.create_uid.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ user.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello <t t-esc="user.name"/>,</p>
                    <p><strong>ATTENTION:</strong> The following lead has been stalled for 30+ days and requires management attention:</p>
                    <ul>
                        <li><strong>Lead:</strong> <t t-esc="object.name"/></li>
                        <li><strong>Site:</strong> <t t-esc="object.site_name or 'N/A'"/></li>
                        <li><strong>Assigned To:</strong> <t t-esc="object.user_id.name or 'Unassigned'"/></li>
                        <li><strong>Stage:</strong> <t t-esc="object.stage_id.name or 'N/A'"/></li>
                        <li><strong>Last Reminder:</strong> <t t-esc="object.last_reminder_date or 'N/A'"/></li>
                        <li><strong>Budget:</strong> <t t-esc="object.budget or 0"/> <t t-esc="object.currency_id.symbol or ''"/></li>
                    </ul>
                    <p>Please review this lead and consider reassigning or taking appropriate action.</p>
                    <p>Best regards,<br/>BTP Prospecting System</p>
                </div>
            </field>
        </record>

        <!-- Lead 6-Month Loop Reminder Email Template -->
        <record id="email_template_lead_loop_reminder" model="mail.template">
            <field name="name">BTP Lead: 6-Month Loop Reminder</field>
            <field name="model_id" ref="model_btp_lead"/>
            <field name="subject">6-Month Follow-up: {{ object.name }}</field>
            <field name="email_from">{{ object.create_uid.email_formatted or user.email_formatted }}</field>
            <field name="email_to">{{ object.user_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Hello <t t-esc="object.user_id.name"/>,</p>
                    <p>This lead was lost/unsuccessful 6 months ago. Consider re-contacting for new opportunities:</p>
                    <ul>
                        <li><strong>Lead:</strong> <t t-esc="object.name"/></li>
                        <li><strong>Site:</strong> <t t-esc="object.site_name or 'N/A'"/></li>
                        <li><strong>Client:</strong> <t t-esc="object.partner_id.name or object.partner_name or 'N/A'"/></li>
                        <li><strong>Previous Status:</strong> <t t-esc="object.response_status or 'N/A'"/></li>
                    </ul>
                    <p>This is a good opportunity to check if there are new projects or needs.</p>
                    <p>Best regards,<br/>BTP Prospecting System</p>
                </div>
            </field>
        </record>

        <!-- BTP Invoice Reminders (Module 7) -->
        <record id="email_template_btp_invoice_reminder_courtesy" model="mail.template">
            <field name="name">BTP Invoice: Courtesy Reminder (D-7)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Payment reminder – Invoice {{ object.name or object.btp_invoice_sequence or '' }} (due {{ object.invoice_date_due }})</field>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>
                    <p>This is a courtesy reminder that the following invoice is due in 7 days:</p>
                    <ul>
                        <li><strong>Invoice:</strong> <t t-esc="object.name or object.btp_invoice_sequence or 'N/A'"/></li>
                        <li><strong>Due date:</strong> <t t-esc="object.invoice_date_due"/></li>
                        <li><strong>Amount:</strong> <t t-esc="object.amount_total"/> <t t-esc="object.currency_id.symbol"/></li>
                    </ul>
                    <p>Please ensure payment is made by the due date.</p>
                    <p>Best regards,<br/><t t-esc="object.company_id.name"/></p>
                </div>
            </field>
        </record>
        <record id="email_template_btp_invoice_reminder_official" model="mail.template">
            <field name="name">BTP Invoice: Official Reminder (D0)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Payment due – Invoice {{ object.name or object.btp_invoice_sequence or '' }}</field>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>
                    <p>This is an official reminder that the following invoice is due for payment:</p>
                    <ul>
                        <li><strong>Invoice:</strong> <t t-esc="object.name or object.btp_invoice_sequence or 'N/A'"/></li>
                        <li><strong>Due date:</strong> <t t-esc="object.invoice_date_due"/></li>
                        <li><strong>Amount:</strong> <t t-esc="object.amount_total"/> <t t-esc="object.currency_id.symbol"/></li>
                    </ul>
                    <p>Please arrange payment as soon as possible.</p>
                    <p>Best regards,<br/><t t-esc="object.company_id.name"/></p>
                </div>
            </field>
        </record>
        <record id="email_template_btp_invoice_reminder_1st" model="mail.template">
            <field name="name">BTP Invoice: 1st Reminder (D+15)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">1st payment reminder – Invoice {{ object.name or object.btp_invoice_sequence or '' }}</field>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>
                    <p>The following invoice is now overdue. Please settle it at your earliest convenience:</p>
                    <ul>
                        <li><strong>Invoice:</strong> <t t-esc="object.name or object.btp_invoice_sequence or 'N/A'"/></li>
                        <li><strong>Due date:</strong> <t t-esc="object.invoice_date_due"/></li>
                        <li><strong>Amount:</strong> <t t-esc="object.amount_total"/> <t t-esc="object.currency_id.symbol"/></li>
                    </ul>
                    <p>Best regards,<br/><t t-esc="object.company_id.name"/></p>
                </div>
            </field>
        </record>
        <record id="email_template_btp_invoice_reminder_2nd" model="mail.template">
            <field name="name">BTP Invoice: 2nd Reminder (D+30)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">2nd payment reminder – Invoice {{ object.name or object.btp_invoice_sequence or '' }}</field>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>
                    <p><strong>Reinforced reminder:</strong> The following invoice remains unpaid. Please proceed to payment without delay:</p>
                    <ul>
                        <li><strong>Invoice:</strong> <t t-esc="object.name or object.btp_invoice_sequence or 'N/A'"/></li>
                        <li><strong>Due date:</strong> <t t-esc="object.invoice_date_due"/></li>
                        <li><strong>Amount:</strong> <t t-esc="object.amount_total"/> <t t-esc="object.currency_id.symbol"/></li>
                    </ul>
                    <p>Failure to pay may result in a formal notice and further steps.</p>
                    <p>Best regards,<br/><t t-esc="object.company_id.name"/></p>
                </div>
            </field>
        </record>
        <record id="email_template_btp_invoice_reminder_formal" model="mail.template">
            <field name="name">BTP Invoice: Formal Notice (D+30)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Formal notice – Unpaid invoice {{ object.name or object.btp_invoice_sequence or '' }}</field>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <t t-esc="object.partner_id.name"/>,</p>
                    <p><strong>FORMAL NOTICE</strong></p>
                    <p>Despite previous reminders, the following invoice remains unpaid:</p>
                    <ul>
                        <li><strong>Invoice:</strong> <t t-esc="object.name or object.btp_invoice_sequence or 'N/A'"/></li>
                        <li><strong>Due date:</strong> <t t-esc="object.invoice_date_due"/></li>
                        <li><strong>Amount:</strong> <t t-esc="object.amount_total"/> <t t-esc="object.currency_id.symbol"/></li>
                    </ul>
                    <p>You are hereby formally notified to settle this amount within the legal timeframe. Failure to do so may lead to recovery procedures.</p>
                    <p>Best regards,<br/><t t-esc="object.company_id.name"/></p>
                </div>
            </field>
        </record>
    </data>
</odoo>

