<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_btp_site_document_expiration_check" model="ir.cron">
            <field name="name">BTP: Check Site Document Expiration</field>
            <field name="model_id" ref="model_btp_site_document"/>
            <field name="state">code</field>
            <field name="code">model = env['btp.site.document']; model._check_document_expiration()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
