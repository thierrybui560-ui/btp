[Unit]
Description=Odoo 19 BTP Prospecting
Documentation=https://www.odoo.com
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/odoo-projects/btp/odoo19
ExecStart=/home/ubuntu/odoo-projects/btp/odoo19/venv/bin/python3 /home/ubuntu/odoo-projects/btp/odoo19/odoo/odoo-bin -c /home/ubuntu/odoo-projects/btp/odoo19/odoo.conf -d odoo_btp
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=odoo-btp

[Install]
WantedBy=multi-user.target
